# Public Supabase config (safe for browser via RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here

# Server-only secrets (NEVER prefix with NEXT_PUBLIC_)
# SUPABASE_SECRET_KEY=sb_secret_...
# INBOUND_WEBHOOK_SECRET=replace-with-strong-random-secret
# AI_GATEWAY_API_KEY=optional-llm-key-for-fallback-extraction
